// qpa
layer-rule {
  match namespace="quickshell-polkit-agent"
  shadow {
    on
    spread 500
    softness 0
    offset x=0 y=0
  }
}

// hyprpaper
layer-rule {
  match namespace="hyprpaper"
  place-within-backdrop true
}

layer-rule {
  match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
  background-effect {
    xray false
  }
}

